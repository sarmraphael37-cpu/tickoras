# ---------------------------------------------------------------------------
# TICKORA environment
# Copy to .env.local and fill in values from your Supabase project settings.
# Never commit .env.local, service-role keys, or provider credentials.
# Values below are PLACEHOLDERS — replace them with your own project's values.
# ---------------------------------------------------------------------------

# Public Supabase project credentials (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://yklttgnkscdggfwprwsu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlrbHR0Z25rc2NkZ2dmd3Byd3N1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTU0NTk5OTksImV4cCI6MjExMTAzNTk5OX0.w9HNs_KSqDbRETZw9OmpseHhrZyfvuOvER9gYqvzLZg

# Server-only. Required for webhooks and privileged administrative jobs only.
# NEVER prefix this with NEXT_PUBLIC_ and never expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlrbHR0Z25rc2NkZ2dmd3Byd3N1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5NTQ1OTk5OSwiZXhwIjoyMTExMDM1OTk5fQ.cdeObgr2NWRZrc4qQMzl7NwSU5UYRaqTijcyXGaw-hk

# Public site URL used in auth redirects and payment return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional verified social profile links. When unset, the footer uses
# platform search pages and never claims an unverified official account.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=www.linkedin.com/in/
sarm-raphael-3620b03b2


# Optional: shared secret for the payment webhook endpoint.
# Real providers must implement signature verification in their adapter.
PAYMENT_WEBHOOK_SECRET=

# Required to call the reservation-expiry cron endpoint.
# Send it as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# One-time administrator bootstrap. Set this to the email of the account that
# should become the first admin, then sign in and visit /setup/admin.
# Leave empty to disable self-service bootstrap (recommended after setup).
ADMIN_BOOTSTRAP_EMAIL=admin@tickora.com

# Payment provider credentials. All providers start UNCONFIGURED.
# The DEMO provider works without credentials but never represents real money.
# In production, demo also requires DEMO_PAYMENTS_ENABLED=true.
DEMO_PAYMENTS_ENABLED=false
MTN_MOMO_API_URL=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
# "sandbox" for testing, "mtn" for Cameroon production
MTN_MOMO_TARGET_ENVIRONMENT=

ORANGE_MONEY_API_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

CARD_PROVIDER_API_URL=
CARD_PROVIDER_SECRET_KEY=
